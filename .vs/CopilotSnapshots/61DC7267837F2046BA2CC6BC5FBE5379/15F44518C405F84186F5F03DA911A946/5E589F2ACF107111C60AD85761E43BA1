using HarmonyLib;
using System;
using System.Collections.Generic;
using System.Reflection;
using System.Reflection.Emit;
using MegaCrit.Sts2.Core.Entities.Cards;
using MegaCrit.Sts2.Core.Entities.Creatures;
using MegaCrit.Sts2.Core.Models;

[HarmonyPatch]
public static class CardDescriptionPatch
{
    // 定义兼容枚举（必须与原始枚举数值一致）
    public enum CompatiblePreviewType
    {
        None = 0,
        Upgrade = 1
    }

    // 动态获取私有枚举（添加安全验证）
    private static Type GetPrivateEnumType()
    {
        var type = typeof(CardModel).GetNestedType("DescriptionPreviewType", BindingFlags.NonPublic);
        if (type == null)
        {
            throw new MissingFieldException("Failed to get private enum DescriptionPreviewType");
        }
        return type;
    }

    // 添加诊断日

    // 补丁私有方法（添加签名验证）
    [HarmonyPatch("GetDescriptionForPile")]
    [HarmonyPriority(int.MaxValue)]
    public static class Patch_PrivateMethod
    {
        [HarmonyTranspiler]
        static IEnumerable<CodeInstruction> Transpiler(IEnumerable<CodeInstruction> insts,
                                                       [FromBinder] Type __originalType)
        {
            // 验证原始方法签名
            var method = AccessTools.Method(typeof(CardModel),
                "GetDescriptionForPile",
                new[] { typeof(PileType), GetPrivateEnumType(), typeof(Creature) });


            var codes = new List<CodeInstruction>(insts);
            bool modified = false;

            // 定位目标指令：description.Add("singleStarIcon", "...")
            for (int i = 0; i < codes.Count; i++)
            {
                if (IsTargetInstruction(i, codes))
                {
                    // 替换为新路径
                    codes[i - 1] = new CodeInstruction(OpCodes.Ldstr,
                        "[img]res://Nono/Images/Packed/Sprite_Fonts/star_icon.png[/img]");
                    modified = true;
                    break;
                }
            }

            // 验证新路径有效性
            ValidateStarIconPath();
            return modified ? codes : insts;
        }

        private static bool IsTargetInstruction(int idx, List<CodeInstruction> codes)
            => idx >= 1
               && codes[idx].opcode == OpCodes.Callvirt
               && codes[idx - 1].opcode == OpCodes.Ldstr
               && codes[idx - 1].operand.ToString() == "singleStarIcon";

        private static void ValidateStarIconPath()
        {
            var path = "Nono/Images/Packed/Sprite_Fonts/star_icon.png";
            if (!System.IO.File.Exists(path))
            {
                throw new FileNotFoundException($"Star icon not found at path: {path}", path);
            }
        }
    }
}