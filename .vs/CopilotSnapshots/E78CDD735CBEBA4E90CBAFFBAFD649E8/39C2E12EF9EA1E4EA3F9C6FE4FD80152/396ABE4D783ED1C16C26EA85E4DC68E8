// 不再在编译时引用 internal 类型，改为运行时通过名字查找并打补丁
public static class GetPlayerDialogueLinePatch
{
    static GetPlayerDialogueLinePatch()
    {
        try
        {
            var harmony = new Harmony("com.nono.patch.getplayerdialogue");
            var targetType = AccessTools.TypeByName("UnplayableReasonExtensions");
            if (targetType == null) return;
            var original = AccessTools.Method(targetType, "GetPlayerDialogueLine");
            if (original == null) return;
            var postfixMethod = typeof(GetPlayerDialogueLinePatch).GetMethod(nameof(Postfix), BindingFlags.Static | BindingFlags.Public | BindingFlags.NonPublic);
            if (postfixMethod == null) return;
            harmony.Patch(original, postfix: new HarmonyMethod(postfixMethod));
        }
        catch
        {
            // 忽略运行时无法打补丁的情况（保持安全）
        }
    }

    // 保留原方法体，去掉 Harmony 属性（不再在编译期依赖 internal 类型）
    public static void Postfix(UnplayableReason reason, ref LocString? __result)
    {
        Player? local = LocalContext.GetMe(CombatManager.Instance.DebugOnlyGetState());
        if (local == null) return;

        if (reason.HasFlag(UnplayableReason.StarCostTooHigh) && local.Character?.Id?.Entry == "your_character_id")
        {
            var loc = LocString.GetIfExists("combat_messages", "NOT_ENOUGH_MANA");
            if (loc != null)
                __result = loc;
        }
       
    }
}
